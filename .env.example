# ═══════════════════════════════════════════════════════════════════════════
# Content Dashboard 2.O — Environment variables template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` (gitignored) and fill in values.
# For production, set these in the Vercel dashboard, NOT in `.env.local`.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App URL ─────────────────────────────────────────────────────────────────
# Base URL sin trailing slash. Usada para construir OAuth callbacks.
# Dev: http://localhost:3000  ·  Prod: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Postgres en Supabase) ─────────────────────────────────────────
# DATABASE_URL  — pooled connection (usar en la app)
# DIRECT_URL    — direct connection (usar en migraciones / prisma CLI)
# Obtain from: Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ─── Supabase Auth ───────────────────────────────────────────────────────────
# Obtain from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasea RLS. Server-only, nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers ────────────────────────────────────────────────────────────
# Anthropic — análisis de guión, copy, chat de reels
# Obtain: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq — transcripción con Whisper v3 turbo (feature: Competidores)
# Obtain: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Scraping ────────────────────────────────────────────────────────────────
# Apify — scraping de Instagram reels
# Obtain: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Obtain: https://resend.com/api-keys
# Si falta, las notificaciones de signup se silencian (no bloquean el flujo).
RESEND_API_KEY=

# ─── Rate limiting (Upstash) ─────────────────────────────────────────────────
# El proyecto usa Upstash con DOS pares de nombres distintos (deuda técnica):
# - KV_REST_*         → lib/utils/ratelimit.ts (Upstash KV vía Vercel integration)
# - UPSTASH_REDIS_*   → lib/rate-limit/signup.ts (Upstash Redis directo)
# Ambos apuntan al mismo backend; se pueden setear con los mismos valores.
# Si faltan, rate limiting queda DESACTIVADO silenciosamente (no es fatal en dev).
# Obtain: https://console.upstash.com/
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OAuth: Meta / Instagram ─────────────────────────────────────────────────
# Obtain: https://developers.facebook.com/apps → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# ─── OAuth: Google / YouTube ─────────────────────────────────────────────────
# Obtain: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth: TikTok ───────────────────────────────────────────────────────────
# Obtain: https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Tests ───────────────────────────────────────────────────────────────────
# URL base para Playwright (default: http://localhost:3000)
E2E_BASE_URL=
