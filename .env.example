# ─── Database (Supabase Postgres) ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── App URL (used in OAuth redirect_uri) ────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ─── Instagram (Meta app — instagram_business_basic scope) ───────────────────
# Register redirect URI: {APP_URL}/api/social/instagram/callback
INSTAGRAM_APP_ID="your_meta_app_id"
INSTAGRAM_APP_SECRET="your_meta_app_secret"

# ─── Meta Ads (same Meta app — ads_read scope) ────────────────────────────────
# If you use a separate Meta app for ads, set these. Otherwise the code falls
# back to INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET automatically.
# Register redirect URI: {APP_URL}/api/social/meta-ads/callback
# FACEBOOK_APP_ID="your_facebook_app_id"
# FACEBOOK_APP_SECRET="your_facebook_app_secret"

# ─── Google / YouTube (youtube.readonly scope) ───────────────────────────────
# Register redirect URI: {APP_URL}/api/social/youtube/callback
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Optional: YouTube Data API key for server-side requests without OAuth
YOUTUBE_API_KEY="AIza..."

# ─── TikTok (user.info.basic + video.list + user.info.stats scopes) ──────────
# Register redirect URI: {APP_URL}/api/social/tiktok/callback
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk_..."

# ─── External services ────────────────────────────────────────────────────────
# Apify: Instagram reel scraper + transcript pipeline
APIFY_API_TOKEN="apify_api_..."
# Resend: transactional email (signup notifications)
RESEND_API_KEY="re_..."

# ─── Rate limiting (Upstash Redis — optional) ────────────────────────────────
# Leave unset to disable rate limiting in local dev
KV_REST_API_URL="https://[id].upstash.io"
KV_REST_API_TOKEN="AX..."
# Set to "true" to enforce stricter limits (recommended in production)
# RATE_LIMIT_STRICT="true"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# From address for transactional emails (must be a verified Resend domain)
RESEND_FROM_EMAIL="noreply@yourdomain.com"
# Admin email that receives signup notifications
SUPER_ADMIN_EMAIL="admin@yourdomain.com"

# ─── OAuth token encryption (security) ───────────────────────────────────────
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Without this, social tokens are stored as plaintext in the database.
# OAUTH_TOKEN_ENCRYPTION_KEY="generate_with_openssl_rand_hex_32"
